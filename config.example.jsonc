{
    "type": "<SQLITE|POSTGRESQL|MYSQL>",
    "dsn": "<DSN>",
    "s3": {
        "endpoint": "<YOUR_S3_ENDPOINT>",
        "region": "<YOUR_AWS_REGION (\"\" if not using AWS)>",
        "bucket": "<YOUR_BUCKET_NAME>",
        "access_key_id": "<YOUR_ACCESS_KEY_ID>",
        "secret_access_key": "<YOUR_SECRET_ACCESS_KEY>",
        "session_token": "<YOUR_SESSION_TOKEN (\"\" if not using AWS)>",
        "force_path_style": true // Set to true if using a custom S3 endpoint (e.g., MinIO, SeaweedFS, RustFS, Ceph, etc.)
    }
}